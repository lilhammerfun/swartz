{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swartz",
  "version": "0.1.0",
  "identifier": "dev.tukdam.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Swartz",
        "width": 1440,
        "height": 980,
        "minWidth": 1000,
        "minHeight": 720,
        "decorations": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
